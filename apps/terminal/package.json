{
  "name": "prism",
  "productName": "Prism",
  "version": "0.7.1",
  "description": "A universal terminal for Windows: PowerShell, cmd and bash in one, admin rights per command, configured like Linux",
  "main": "src/main.js",
  "author": "onufry444",
  "license": "MIT",
  "homepage": "https://github.com/onufry444/prism",
  "scripts": {
    "start": "electron .",
    "test": "node test/translate.test.js && node test/shells.test.js && node test/handoff.test.js",
    "dist": "electron-builder --win zip --x64 --publish never"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.github.onufry444.prism",
    "productName": "Prism",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**",
      "node_modules/koffi/**"
    ],
    "extraFiles": [
      {
        "from": "../../installer",
        "to": "engine/installer"
      },
      {
        "from": "native/build",
        "to": ".",
        "filter": [
          "prism-handoff.exe"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Prism-win-x64.${ext}"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
