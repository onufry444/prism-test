{
  "$schema": "./schema.json",
  "id": "tiles",
  "name": "Tiles",
  "author": "Prism",
  "version": "2.0.0",
  "description": "Hyprland-style tiling: windows arrange themselves, keyboard-driven, thin accent borders, gaps and a workspace bar.",
  "colors": { "mode": "dark", "background": "#0f1117", "surface": "#1a1d27", "text": "#e4e6f0", "muted": "#7d8197", "accent": "#c792ff", "accent2": "#5ee6c8" },
  "effects": { "transparency": true, "opacity": 88, "blur": false, "radius": 8 },
  "fonts": { "mono": "Cascadia Code", "size": 14 },
  "wallpaper": { "type": "gradient", "angle": 45, "colors": ["#0f1117", "#2a1745", "#0f3b45"] },
  "taskbar": { "alignment": "left" },
  "windows": { "tiling": true, "gaps": { "inner": 10, "outer": 12 }, "border": { "enabled": true, "focused": "accent", "inactive": "surface" }, "corners": "small_rounded", "inactiveOpacity": 94 },
  "dock": { "enabled": false },
  "bar": { "enabled": true, "height": 30, "left": ["menu", "workspaces", "app"], "center": ["clock"], "right": ["cpu", "memory", "battery", "network"] },
  "terminal": { "scheme": "tokyo" }
}
