{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/onufry444/prism/themes/schema.json",
  "title": "Prism theme",
  "description": "One file describing the whole look of the desktop. Fields that take a color accept #RRGGBB or a color name from the colors section (e.g. \"accent\").",
  "type": "object",
  "required": [
    "id",
    "name",
    "colors"
  ],
  "definitions": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "colorRef": {
      "description": "#RRGGBB or a color name from the colors section",
      "type": "string",
      "pattern": "^(#[0-9a-fA-F]{6}|[a-zA-Z][a-zA-Z0-9]*)$"
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,40}$",
      "description": "Same as the file name without .json"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "colors": {
      "type": "object",
      "required": [
        "mode",
        "background",
        "text",
        "accent"
      ],
      "properties": {
        "mode": {
          "enum": [
            "dark",
            "light"
          ],
          "description": "Windows and app mode"
        },
        "background": {
          "$ref": "#/definitions/hex"
        },
        "surface": {
          "$ref": "#/definitions/hex"
        },
        "text": {
          "$ref": "#/definitions/hex"
        },
        "muted": {
          "$ref": "#/definitions/hex"
        },
        "accent": {
          "$ref": "#/definitions/hex",
          "description": "Windows accent, active window border, terminal cursor"
        },
        "accent2": {
          "$ref": "#/definitions/hex"
        }
      },
      "additionalProperties": {
        "$ref": "#/definitions/hex"
      }
    },
    "effects": {
      "type": "object",
      "properties": {
        "transparency": {
          "type": "boolean",
          "description": "Windows transparency effects"
        },
        "opacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Terminal background opacity"
        },
        "blur": {
          "type": "boolean",
          "description": "Blur behind the Prism terminal"
        },
        "radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        }
      },
      "additionalProperties": false
    },
    "fonts": {
      "type": "object",
      "properties": {
        "mono": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 9,
          "maximum": 28
        }
      },
      "additionalProperties": false
    },
    "wallpaper": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "gradient",
            "image",
            "none"
          ]
        },
        "colors": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "$ref": "#/definitions/colorRef"
          }
        },
        "angle": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "path": {
          "type": "string",
          "description": "For type=image: path relative to the theme file (or absolute)"
        }
      },
      "additionalProperties": false
    },
    "taskbar": {
      "type": "object",
      "properties": {
        "alignment": {
          "enum": [
            "left",
            "center"
          ]
        }
      },
      "additionalProperties": false
    },
    "windows": {
      "type": "object",
      "properties": {
        "tiling": {
          "type": "boolean",
          "description": "true = installs and starts GlazeWM"
        },
        "gaps": {
          "type": "object",
          "properties": {
            "inner": {
              "type": "integer",
              "minimum": 0,
              "maximum": 80
            },
            "outer": {
              "type": "integer",
              "minimum": 0,
              "maximum": 120
            }
          },
          "additionalProperties": false
        },
        "border": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "focused": {
              "$ref": "#/definitions/colorRef"
            },
            "inactive": {
              "$ref": "#/definitions/colorRef"
            }
          },
          "additionalProperties": false
        },
        "corners": {
          "enum": [
            "rounded",
            "small_rounded",
            "square"
          ]
        },
        "hideTitleBar": {
          "type": "boolean"
        },
        "inactiveOpacity": {
          "type": "integer",
          "minimum": 30,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "terminal": {
      "type": "object",
      "properties": {
        "scheme": {
          "enum": [
            "prism",
            "tokyo",
            "catppuccin",
            "gruvbox",
            "nord",
            "dracula",
            "rosepine",
            "onedark",
            "solarized-light",
            "paper"
          ]
        },
        "palette": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/hex"
          }
        }
      },
      "additionalProperties": false
    },
    "dock": {
      "type": "object",
      "description": "The Prism dock (shown while the Prism app runs)",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "iconSize": {
          "type": "integer",
          "minimum": 24,
          "maximum": 96
        },
        "magnification": {
          "type": "number",
          "minimum": 1,
          "maximum": 3
        },
        "autohide": {
          "type": "boolean"
        },
        "hideTaskbar": {
          "type": "boolean"
        },
        "labels": {
          "type": "boolean"
        },
        "showRunning": {
          "type": "boolean"
        },
        "reserveSpace": {
          "type": "boolean"
        },
        "position": {
          "enum": [
            "bottom"
          ]
        }
      },
      "additionalProperties": false
    },
    "bar": {
      "type": "object",
      "description": "The Prism menu bar",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "height": {
          "type": "integer",
          "minimum": 20,
          "maximum": 60
        },
        "reserveSpace": {
          "type": "boolean"
        },
        "clockFormat": {
          "type": "string"
        },
        "left": {
          "type": "array",
          "items": {
            "enum": [
              "menu",
              "workspaces",
              "app",
              "clock",
              "date",
              "cpu",
              "memory",
              "battery",
              "network"
            ]
          }
        },
        "center": {
          "type": "array",
          "items": {
            "enum": [
              "menu",
              "workspaces",
              "app",
              "clock",
              "date",
              "cpu",
              "memory",
              "battery",
              "network"
            ]
          }
        },
        "right": {
          "type": "array",
          "items": {
            "enum": [
              "menu",
              "workspaces",
              "app",
              "clock",
              "date",
              "cpu",
              "memory",
              "battery",
              "network"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
