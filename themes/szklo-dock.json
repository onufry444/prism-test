{
  "$schema": "./schema.json",
  "id": "szklo-dock",
  "name": "Szkło Dock",
  "author": "Prism",
  "version": "1.0.0",
  "description": "Spokojny, szklany pulpit: pasek jak dock na środku, zaokrąglone okna, ciepła tapeta o zmierzchu.",
  "colors": {
    "mode": "dark",
    "background": "#14161c",
    "surface": "#1e2129",
    "text": "#eceae4",
    "muted": "#9a9aa2",
    "accent": "#7aa7ff",
    "accent2": "#ff9f7a"
  },
  "effects": { "transparency": true, "opacity": 72, "blur": true, "radius": 14 },
  "fonts": { "ui": "Segoe UI Variable", "mono": "Cascadia Code", "size": 14 },
  "wallpaper": { "type": "gradient", "angle": 120, "colors": ["#1b2140", "#4b3a78", "#c46a7a", "#f2b38a"] },
  "taskbar": { "alignment": "center", "windhawk": { "taskbarStyler": "DockLike" } },
  "windows": {
    "tiling": false,
    "border": { "enabled": false, "focused": "accent", "inactive": "surface" },
    "corners": "rounded",
    "hideTitleBar": false,
    "inactiveOpacity": 100
  },
  "terminal": { "enabled": true, "ansi": "dark" }
}
